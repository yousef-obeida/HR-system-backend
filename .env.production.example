###############################################################################
# Production environment for the Dockerized HR System.
#
# Copy this to `.env` on the VPS and fill in the real values:
#     cp .env.production.example .env
# Then generate an app key once:
#     docker compose run --rm app php artisan key:generate --force
###############################################################################

APP_NAME="Smart HR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Host port nginx is published on (mapped to container :80). Put a reverse
# proxy / TLS terminator (Caddy, Traefik, host nginx) in front of this.
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---- Database (MySQL service) -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hr_system
DB_USERNAME=hr_user
DB_PASSWORD=change-me-strong-password
# Used to bootstrap the MySQL container's root account.
DB_ROOT_PASSWORD=change-me-strong-root-password

# ---- Cache / Session / Queue ------------------------------------------------
# Redis is recommended in production. Switch QUEUE_CONNECTION to "database"
# if you prefer the DB-backed queue instead.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Mail (configure with your real SMTP provider) --------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AI (Google Gemini) -----------------------------------------------------
# Set the key your laravel/ai integration expects.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- PDF extraction ---------------------------------------------------------
# `pdftotext` is installed in the image and on PATH, so the default is correct.
PDFTOTEXT_PATH=pdftotext
